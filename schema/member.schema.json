{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ComD Team Member",
  "description": "Communication Design Team メンバー情報スキーマ",
  "type": "object",
  "required": ["id", "name", "role", "status"],
  "properties": {
    "id": { "type": "string" },
    "name": {
      "type": "object",
      "required": ["ja"],
      "properties": {
        "ja": { "type": "string" },
        "reading": { "type": "string", "description": "よみがな" },
        "en": { "type": "string" }
      }
    },
    "role": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["active", "on_leave", "part_time", "contractor"]
    },
    "birth_year": { "type": "integer" },
    "joined_date": { "type": "string", "format": "date" },
    "contact": {
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "slack": { "type": "string" }
      }
    },
    "background": {
      "type": "array",
      "description": "学歴・職歴・資格などのバックグラウンド",
      "items": { "type": "string" }
    },
    "strengths": {
      "type": "array",
      "description": "強み・特徴（定性）",
      "items": { "type": "string" }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "level"],
        "properties": {
          "name": { "type": "string" },
          "level": { "type": "integer", "minimum": 1, "maximum": 5 },
          "category": {
            "type": "string",
            "enum": ["design", "copy", "strategy", "tool", "management", "other"]
          }
        }
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "level"],
        "properties": {
          "name": { "type": "string" },
          "level": { "type": "string", "enum": ["beginner", "intermediate", "advanced", "expert"] }
        }
      }
    },
    "expertise": {
      "type": "array",
      "items": { "type": "string" }
    },
    "clifton_strengths": {
      "type": "object",
      "description": "CliftonStrengths（ストレングスファインダー）",
      "properties": {
        "top5": { "type": "array", "items": { "type": "string" } },
        "top10": { "type": "array", "items": { "type": "string" } },
        "summary": { "type": "string", "description": "資質から見た大きな傾向まとめ" }
      }
    },
    "talent_analytics": {
      "type": "object",
      "description": "Talent Analytics診断結果",
      "properties": {
        "assessed_at": { "type": "string", "description": "診断時点（例: 2019年、32歳）" },
        "scores": {
          "type": "object",
          "description": "各指標スコア（0〜100）",
          "additionalProperties": { "type": "number" }
        }
      }
    },
    "peer_feedback": {
      "type": "object",
      "description": "周囲（AD・プロデューサー等）からのGood/More評価",
      "properties": {
        "period": { "type": "string" },
        "source": { "type": "string", "description": "評価者の属性（例: ADチーム）" },
        "good": { "type": "array", "items": { "type": "string" } },
        "more": { "type": "array", "items": { "type": "string" } },
        "additional_comments": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "role", "status"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "role": { "type": "string" },
          "status": { "type": "string", "enum": ["active", "completed", "on_hold"] },
          "start_date": { "type": "string", "format": "date" },
          "end_date": { "type": "string", "format": "date" }
        }
      }
    },
    "self_evaluation": {
      "type": "object",
      "description": "自己評価（上期・下期ごと）",
      "properties": {
        "period": { "type": "string", "description": "例: 2025-上期 (2025/06/01〜2025/11/30)" },
        "summary": { "type": "string" },
        "achievements": { "type": "array", "items": { "type": "string" } },
        "areas_for_improvement": { "type": "array", "items": { "type": "string" } },
        "growth_areas": { "type": "array", "items": { "type": "string" } }
      }
    },
    "goals": {
      "type": "object",
      "properties": {
        "fiscal_year": { "type": "string" },
        "okrs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "objective": { "type": "string" },
              "key_results": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "description": { "type": "string" },
                    "target": { "type": "number" },
                    "current": { "type": "number" },
                    "unit": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "evaluations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["period", "overall"],
        "properties": {
          "period": { "type": "string" },
          "overall": { "type": "string", "enum": ["S", "A", "B", "C", "D"] },
          "comment": { "type": "string" },
          "strengths": { "type": "array", "items": { "type": "string" } },
          "areas_for_growth": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "one_on_ones": {
      "type": "array",
      "description": "1on1ログ（解釈を加えず記録）",
      "items": {
        "type": "object",
        "required": ["date", "memo"],
        "properties": {
          "date": { "type": "string", "format": "date" },
          "memo": { "type": "string", "description": "1on1メモ（原文ログ）" },
          "action_items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "description": { "type": "string" },
                "owner": { "type": "string" },
                "due_date": { "type": "string", "format": "date" },
                "done": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "core_theme": {
      "type": "object",
      "description": "「全員がプロジェクトの中心人物になる」の個人別翻訳",
      "properties": {
        "translation": { "type": "string", "description": "そのメンバーにとっての中心人物化の意味" },
        "half_year_theme": { "type": "string", "description": "半年ごとの仮テーマ" },
        "future_comment": { "type": "string", "description": "未来志向コメント" }
      }
    },
    "management_memo": {
      "type": "string",
      "description": "宮崎太郎によるマネジメントメモ（自由記述）"
    },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
